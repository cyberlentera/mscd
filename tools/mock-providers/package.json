{
  "name": "@mscd/mock-providers",
  "version": "1.0.0",
  "private": true,
  "description": "Local mock servers for the Microsoft identity, Microsoft Graph and Google Drive APIs that MSCD uses (tests and demo only)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "@mscd/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "fastify": "5.11.3",
    "jose": "6.2.12"
  },
  "devDependencies": {
    "vitest": "3.2.7"
  }
}
