{
  "name": "@mscd/server",
  "version": "1.0.0",
  "private": true,
  "description": "MSCD server: run modes api, worker, storage-gateway and migrate, plus admin commands (mscd-server)",
  "type": "commonjs",
  "main": "dist/main.js",
  "bin": {
    "mscd-server": "dist/main.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "gen:build-info": "node scripts/gen-build-info.mjs",
    "prebuild": "node scripts/gen-build-info.mjs",
    "build": "tsc -b tsconfig.build.json",
    "pretypecheck": "node scripts/gen-build-info.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pretest": "node scripts/gen-build-info.mjs",
    "test": "vitest run -c vitest.unit.config.ts --passWithNoTests",
    "pretest:int": "node scripts/gen-build-info.mjs",
    "test:int": "vitest run -c vitest.int.config.ts --passWithNoTests",
    "start": "node dist/main.js api",
    "migrate": "node dist/main.js migrate",
    "seed:demo": "node scripts/seed-demo.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1144.0",
    "@aws-sdk/lib-storage": "3.1144.0",
    "@fastify/cookie": "11.1.2",
    "@fastify/helmet": "13.1.1",
    "@fastify/multipart": "9.4.0",
    "@fastify/rate-limit": "10.3.0",
    "@mscd/pack-tools": "*",
    "@mscd/shared": "*",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-fastify": "11.2.7",
    "@node-rs/argon2": "2.2.1",
    "@node-saml/node-saml": "5.1.0",
    "@opentelemetry/auto-instrumentations-node": "0.80.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.222.0",
    "@opentelemetry/sdk-node": "0.222.0",
    "bullmq": "5.81.5",
    "commander": "14.0.3",
    "csv-parse": "6.2.1",
    "csv-stringify": "6.9.0",
    "exceljs": "4.4.0",
    "fastify": "5.11.3",
    "ical-generator": "8.1.1",
    "ioredis": "5.11.1",
    "jose": "6.2.12",
    "kysely": "0.28.17",
    "nestjs-pino": "4.6.1",
    "nodemailer": "7.0.13",
    "openid-client": "6.8.8",
    "pdf-lib": "1.17.1",
    "pg": "8.23.1",
    "pg-boss": "12.35.1",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "tar": "7.5.22",
    "undici": "7.30.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@mscd/mock-providers": "*",
    "@mscd/web": "*",
    "@nestjs/testing": "11.2.7",
    "@swc/core": "1.16.13",
    "@testcontainers/postgresql": "11.14.0",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "3.2.7",
    "testcontainers": "11.14.0",
    "unplugin-swc": "2.0.0",
    "vitest": "3.2.7"
  }
}
