# MSCD on-premise settings for Docker Compose.
# install.sh creates .env from this file. To change a setting later, edit .env
# and run "docker compose up -d" in the same directory (or re-run install.sh).
# Values are used as they are: no quotes, no spaces around "=".

# Release to run. upgrade.sh updates this value.
MSCD_VERSION=1.0.0
# Image repositories. MSCD_IMAGE is the web image (the name predates the
# server images and is kept for existing installations).
MSCD_IMAGE=cyberlentera/mscd-web
MSCD_SERVER_IMAGE=cyberlentera/mscd-server

# Bundled services to run: bundled-db (PostgreSQL 16), bundled-s3 (SeaweedFS,
# the Managed Vault object store) and, with MSCD_JOBS_DRIVER=bullmq, bullmq
# (Valkey). Remove bundled-db or bundled-s3 only when you use your own
# PostgreSQL or S3 store (see INSTALL-ONPREM.md).
COMPOSE_PROFILES=bundled-db,bundled-s3

# Host name users type in the browser. Used for the self-signed certificate,
# the HTTP to HTTPS redirect and the URL that install.sh prints.
MSCD_DOMAIN=mscd.example.internal
# Address of MSCD as users open it, used in links (emails, sign-in callbacks).
# install.sh derives it from MSCD_DOMAIN and MSCD_HTTPS_PORT.
MSCD_PUBLIC_URL=https://mscd.example.internal

# Host address and ports to publish. 0.0.0.0 listens on all IPv4 addresses.
MSCD_BIND_ADDRESS=0.0.0.0
MSCD_HTTP_PORT=80
MSCD_HTTPS_PORT=443

# TLS certificate source: self-signed or provided. The files live in ./tls.
MSCD_TLS_MODE=self-signed

# true: plain HTTP requests are redirected to HTTPS (/healthz stays on HTTP).
MSCD_HTTP_REDIRECT=true

# true: send Strict-Transport-Security. Use only with a trusted certificate.
MSCD_HSTS=false

# true: allow the optional Google Fonts used by alternative font pairings.
# Browsers then need internet access to fonts.googleapis.com and fonts.gstatic.com.
# The default font (IBM Plex) is bundled and works offline.
MSCD_EXTERNAL_FONTS=false

# Addresses or CIDR ranges of a reverse proxy or load balancer in front of MSCD,
# separated by commas. Its X-Forwarded-For header then names the client. Leave
# empty when browsers connect to this host directly.
MSCD_TRUSTED_PROXY_CIDRS=

# Internal network of the containers. Change both values only when the subnet
# is already used on this host; MSCD_WEB_ADDRESS must be inside MSCD_SUBNET.
MSCD_SUBNET=172.31.250.0/24
MSCD_WEB_ADDRESS=172.31.250.10

# Organisation created by install.sh (the slug names the database schema
# org_<slug> and cannot change later).
MSCD_ORG_SLUG=
MSCD_ORG_NAME=

# Outgoing email through your SMTP relay. With MSCD_SMTP_USER set, install.sh
# stores the password in secrets/smtp.password and sets MSCD_SMTP_PASSWORD_FILE.
# The api (account emails), the worker (notifications) and cli (invitations)
# mount that file and reach the relay through the egress network.
MSCD_MAIL_FROM=MSCD <mscd@example.internal>
MSCD_SMTP_HOST=smtp
MSCD_SMTP_PORT=25
MSCD_SMTP_SECURE=false
MSCD_SMTP_USER=
MSCD_SMTP_PASSWORD_FILE=

# Managed Vault object store. The default is the bundled SeaweedFS; for your own
# S3-compatible store set the endpoint and put its keys in secrets/s3.access
# and secrets/s3.secret.
MSCD_S3_ENDPOINT=http://objectstore:8333
MSCD_S3_BUCKET=mscd-vault
MSCD_S3_REGION=us-east-1

# Job queue: pgboss (in PostgreSQL, the default) or bullmq (add bullmq to
# COMPOSE_PROFILES and set MSCD_BULLMQ_URL=redis://valkey:6379).
MSCD_JOBS_DRIVER=pgboss
MSCD_BULLMQ_URL=

# Log level of api, worker and storage-gateway: error, warn, info or debug.
MSCD_LOG_LEVEL=info

# Container resource limits. MSCD_CPU_LIMIT and MSCD_MEMORY_LIMIT are the web
# container's.
MSCD_CPU_LIMIT=1.0
MSCD_MEMORY_LIMIT=256M
MSCD_API_CPUS=2.0
MSCD_API_MEMORY=1G
MSCD_WORKER_CPUS=2.0
MSCD_WORKER_MEMORY=1G
MSCD_GATEWAY_CPUS=2.0
MSCD_GATEWAY_MEMORY=1G
MSCD_POSTGRES_CPUS=2.0
MSCD_POSTGRES_MEMORY=2G
MSCD_OBJECTSTORE_CPUS=2.0
MSCD_OBJECTSTORE_MEMORY=2G
MSCD_VALKEY_CPUS=1.0
MSCD_VALKEY_MEMORY=512M

# User and group IDs the web container runs as. install.sh fills these in: run
# with sudo, it creates a system account named mscd; run by a docker group
# member, it uses that user's IDs. 101 is the image default. The api, worker
# and storage-gateway always run as 10001.
MSCD_RUN_UID=101
MSCD_RUN_GID=101
