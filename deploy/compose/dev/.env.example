# MSCD developer stack settings. Every value below is the default built into
# compose.yml, so this file is optional. To change a setting, copy this file to
# .env in the same folder (deploy/compose/dev/.env, ignored by git) and edit it.
# Compose reads it also when you run it from the repository root with -f.

# Optional services to start without --profile flags: bullmq (Valkey), sso (Keycloak).
# COMPOSE_PROFILES=bullmq,sso

# Host address the ports are published on. 127.0.0.1 keeps the stack private to
# this machine. Use 0.0.0.0 only on a trusted network: the passwords are public.
MSCD_DEV_BIND_ADDRESS=127.0.0.1

# Host ports (fixed in BUILD-PLAN R-05; change them here when one is taken).
MSCD_DEV_POSTGRES_PORT=55432
MSCD_DEV_S3_PORT=58333
MSCD_DEV_VALKEY_PORT=56379
MSCD_DEV_KEYCLOAK_PORT=58080
MSCD_DEV_SMTP_PORT=51025
MSCD_DEV_MAILPIT_PORT=58025

# PostgreSQL superuser (postgres) password. Used only when the data volume is
# first created; changing it later has no effect until the volume is reset.
MSCD_DEV_POSTGRES_PASSWORD=postgres-dev

# Keycloak administrator for the admin console at http://localhost:58080/admin/
MSCD_DEV_KEYCLOAK_ADMIN=admin
MSCD_DEV_KEYCLOAK_ADMIN_PASSWORD=admin-dev
MSCD_DEV_KEYCLOAK_LOG_LEVEL=info
